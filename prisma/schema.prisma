// Prisma schema for the CS2 Matchroom app.
// SQLite does not support native enums, so role/status/team fields are plain
// String columns constrained by the TS union types in src/lib/types.ts —
// validate against those unions at every write boundary (server actions/routes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  steamId64     String   @unique
  name          String
  avatarUrl     String?
  role          String   @default("PLAYER") // "ADMIN" | "HOST" | "PLAYER"
  manualRating  Float?
  createdAt     DateTime @default(now())

  wins          Int          @default(0)
  losses        Int          @default(0)
  // A genuine synthetic identity — "fill with bots" test mode, fake
  // SteamID, will never actually log in. NOT the same as isPlaceholder
  // below (a real person can be a placeholder without being a bot).
  isBot         Boolean      @default(false)
  // Row exists but nobody's actually logged in and been invited yet —
  // "fill with bots" test accounts, and real people who showed up in an
  // imported demo but haven't joined for real. Excluded from Players
  // Lounge/Admin Users, and the Steam callback routes them through the
  // invite flow instead of auto-logging them in (see submitInviteCode,
  // which promotes the row on success instead of creating a duplicate).
  isPlaceholder Boolean      @default(false)

  hostedRooms   Room[]       @relation("RoomHost")
  roomPlayers   RoomPlayer[]
  matchStats    MatchPlayerStats[]
  chatMessages  ChatMessage[]
}

// At most one non-terminal (status not COMPLETED/CANCELLED) Room should
// exist at a time — enforced in the setup action, not the schema. Past
// rooms stay around for Players Lounge history; there's no more join code,
// since access is gated at signup by ServerConfig.inviteCode instead.
model Room {
  id                String   @id @default(cuid())
  label             String
  hostUserId        String
  host              User     @relation("RoomHost", fields: [hostUserId], references: [id])
  status            String   @default("SETUP") // SETUP | VETO | READY | LIVE | COMPLETED | CANCELLED
  format            String   @default("BO1") // BO1 | BO3 | BO5
  mapPool           String   // JSON array of map strings
  knifeRound        Boolean  @default(true)
  overtimeEnabled   Boolean  @default(true)
  mode              String   @default("SELF_SELECT") // SELF_SELECT | CAPTAIN_DRAFT
  teamAName         String   @default("Team A")
  teamBName         String   @default("Team B")
  // MatchZy Enhanced "simulation mode" — spawns bots mapped to the
  // configured SteamIDs and auto-plays the match, for testing the
  // RCON/webhook pipeline without needing real players connected.
  simulation        Boolean  @default(false)
  // Host-controlled — while true, players can't self-switch teams via
  // setTeam (see actions.ts). Host tools (unassignPlayer, assignCaptain,
  // assignCoach) are unaffected, same as every other host override
  // elsewhere in this app.
  teamsLocked       Boolean  @default(false)
  createdAt         DateTime @default(now())

  players      RoomPlayer[]
  veto         Veto?
  draft        Draft?
  match        Match?
  chatMessages ChatMessage[]
}

// Lightweight room-scoped chat — polled the same way as everything else on
// the matchroom page (see AutoRefresh), no websocket layer. Good enough for
// a casual crew; latency is however often AutoRefresh's interval is.
model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

model RoomPlayer {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  team      String   @default("UNASSIGNED") // A | B | UNASSIGNED
  isCaptain Boolean  @default(false)
  isCoach   Boolean  @default(false) // mutually exclusive with isCaptain, enforced in the toggle actions
  isReady   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  // Bumped by a client-side heartbeat while the matchroom page is open —
  // there's no websocket/presence layer, so this is how we tell "closed
  // the tab" apart from "still here". See PresenceHeartbeat.tsx.
  lastSeenAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Veto {
  id               String   @id @default(cuid())
  roomId           String   @unique
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status           String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  steps            String   @default("[]") // JSON array of {team, map, action} ban/pick log
  finalMapList     String?  // JSON array of resolved map names, in play order
  overriddenByHost Boolean  @default(false)
  // Only meaningful when Room.knifeRound is false — there's no in-game
  // knife round to decide starting sides, so instead: whichever team did
  // NOT make the deciding ban gets to choose (they didn't get the last
  // map pick, so they get the side pick instead). If the veto resolved
  // with zero bans at all (a single map picked directly, no elimination
  // to react to), sideChoiceTeam is instead a coin-flip result — see
  // sideChoiceTeamFromSteps in lib/veto.ts.
  sideChoiceTeam String? // "A" | "B" | null
  chosenSide     String? // "CT" | "T" | null — set once sideChoiceTeam actually picks
  updatedAt      DateTime @updatedAt
}

// Only relevant when Room.mode === "CAPTAIN_DRAFT". Parallel shape to Veto.
model Draft {
  id        String   @id @default(cuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status    String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE
  steps     String   @default("[]") // JSON array of {team, roomPlayerId} pick log
  updatedAt DateTime @updatedAt
}

model Match {
  id                String   @id @default(cuid())
  roomId            String   @unique
  room              Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  matchzyMatchId    String   @unique
  status            String   @default("LOADING") // LOADING | WARMUP | KNIFE | LIVE | PAUSED | COMPLETED | CANCELLED
  currentMapIndex   Int      @default(0)
  currentMap        String?
  team1Score        Int      @default(0)
  team2Score        Int      @default(0)
  winnerTeam        String?  // "A" | "B" — set once, when wins/losses are credited
  connectedPlayers  String   @default("[]") // JSON array of steamId64 currently connected
  configJson        String   // the exact Get5-style JSON served to matchzy_loadmatch_url
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events      MatchEvent[]
  playerStats MatchPlayerStats[]
}

// Per-player box score for a completed match — sourced from parsing the
// CS2 demo file (see src/lib/demoImport.ts), since MatchZy's live webhook
// only carries score/round events, not this level of detail. Not
// populated for matches without an imported demo.
model MatchPlayerStats {
  id            String @id @default(cuid())
  matchId       String
  match         Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id])
  team          String // "A" | "B"
  kills         Int
  deaths        Int
  assists       Int
  headshotKills Int
  damage        Int
  roundsPlayed  Int
  mvps          Int    @default(0)
  score         Int    @default(0)

  @@unique([matchId, userId])
}

model MatchEvent {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  eventType  String
  payload    String   // raw JSON payload as received from MatchZy's webhook
  receivedAt DateTime @default(now())

  @@index([matchId])
}

// Singleton row (id always "singleton") holding admin-editable server settings.
model ServerConfig {
  id                    String  @id @default("singleton")
  rconHost              String  @default("")
  rconPort              Int     @default(27015)
  rconPasswordEncrypted String  @default("")
  webhookSharedSecret   String  @default("")
  appPublicUrl          String  @default("")
  // What players actually type as `connect <this>` in the CS2 console to
  // join a live match. Kept separate from rconHost/rconPort — RCON is this
  // app talking to the server (often over a LAN IP), while this needs to be
  // whatever address a player's game client can reach (could be a public
  // IP/domain and a different port).
  gameConnectAddress    String  @default("")
  // Optional LAN-reachable base URL (e.g. http://192.168.1.185:3000), used
  // only for matchzy_demo_upload_url. Demo files are large (tens of MB) —
  // routing them out through the public domain and back (Cloudflare/NPM)
  // is bottlenecked by home upload bandwidth and can blow past MatchZy's
  // fixed 60s upload timeout. When the CS2 server and this app are on the
  // same network, setting this keeps that one large transfer on the LAN.
  // Leave blank to just use appPublicUrl for everything, as before.
  localAppUrl           String  @default("")
  // Site-wide signup gate. Required only to create a brand-new account —
  // existing users log back in freely. Empty means "invites not open yet".
  inviteCode            String  @default("")
}
