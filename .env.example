# Copy to .env for local dev, or set these as environment variables on the
# Docker/Portainer stack in production.

# SQLite file path. In Docker this should point at the mounted volume, e.g.
# file:/app/data/db.sqlite
DATABASE_URL="file:./dev.db"

# 32+ char random secret used to encrypt session cookies (iron-session) and
# the RCON password at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# Steam Web API key, used to fetch player name/avatar on login.
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

# Base URL this app is reachable at (no trailing slash). Used for:
#  - the Steam OpenID return_to callback URL
#  - the matchzy_loadmatch_url config URL handed to the CS2 server via RCON,
#    which means this MUST be reachable from the CS2 server's network
#    (e.g. a LAN address/hostname), not "localhost".
APP_PUBLIC_URL="http://localhost:3000"

# RCON host/port/password, webhook shared secret, and this app's public URL
# are also editable at runtime from /admin/server once logged in as an
# admin — the values above are only used until that's configured, and as
# defaults for a fresh install.

# Optional. Raises Leetify's public-API rate limit for the "balance teams
# by rating" lookups. Get one at https://leetify.com/app/developer — the
# app works fine without it, just with stricter unauthenticated limits.
LEETIFY_API_KEY=""
